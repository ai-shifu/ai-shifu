# Next.js bootstrap configuration. Restart Next after local changes.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5800
NEXT_PUBLIC_LOGIN_METHODS_ENABLED=phone,google
NEXT_PUBLIC_DEFAULT_LOGIN_METHOD=google

# Product payment and legal settings belong to the Flask process environment.
# Configure STRIPE_ENABLED, STRIPE_PUBLISHABLE_KEY, PAYMENT_CHANNELS_ENABLED,
# LEGAL_AGREEMENT_URL_* and LEGAL_PRIVACY_URL_* there. The browser reads their
# public projection from /api/runtime-config; NEXT_PUBLIC_STRIPE_* is inactive.
