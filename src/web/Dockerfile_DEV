FROM node:22.23.4 AS base

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    . /etc/os-release && \
    case "$VERSION_CODENAME" in \
      bookworm) minimum_ca='20250419~deb12u2' ;; \
      trixie) minimum_ca='20250419+deb13u1' ;; \
      *) echo "Unsupported Debian release: $VERSION_CODENAME"; exit 1 ;; \
    esac && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$minimum_ca" && \
    update-ca-certificates --fresh && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable

# set work directory
WORKDIR /app

# install project dependencies
# copy package.json and package-lock.json files
COPY package*.json ./

# install dependencies
RUN npm ci --ignore-scripts

# copy project source code after dependencies so source-only changes reuse the
# lockfile-keyed install layer
COPY . .

# expose port
EXPOSE 3000

# start service
CMD ["npm", "run", "dev"]
